<?xml version="1.0" encoding="utf-8"?>
<!-- Tema de ventana: solo cubre el instante antes de que Compose dibuje
     (evita el destello blanco al abrir en modo oscuro). Los colores reales
     los pone KushareTheme. -->
<resources>
    <style name="Theme.Kushare" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFFAF8FF</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
